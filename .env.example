# TechTrack Production Configuration Template

## Copy this file and fill in your actual Hostinger details

## 🗄️ Database Configuration
DB_HOST=localhost
DB_NAME=your_hostinger_database_name
DB_USER=your_hostinger_database_user
DB_PASS=your_database_password_here

## 🌐 Application URLs
BASE_URL=https://yourdomain.com/
# OR if in subdirectory:
# BASE_URL=https://yourdomain.com/techtrack/

ENVIRONMENT=production

## 🔐 Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/googleauth/callback

## 💳 PayMongo (Optional)
PAYMONGO_TEST_MODE=false
PAYMONGO_LIVE_PUBLIC_KEY=pk_live_YOUR_KEY_HERE
PAYMONGO_LIVE_SECRET_KEY=sk_live_YOUR_KEY_HERE

## 📧 Email Settings (Optional)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_email_password
SMTP_FROM=noreply@yourdomain.com
